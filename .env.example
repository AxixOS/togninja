# Production environment example for Heroku/GitHub
# Copy to .env for local dev. On Heroku, set these as Config Vars.

# Core
NODE_ENV=production
# Heroku provides PORT automatically
# PORT=3001
APP_URL=https://your-app.herokuapp.com
APP_BASE_URL=

# Database
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Admin and sessions
ADMIN_TOKEN=change-me-strong-admin-token
SHOOTCLEANER_API_KEY=replace-with-dedicated-shootcleaner-key
SECRET_ADMIN_TOKEN=
SESSION_SECRET=change-me-random-string
# Enable to log backend login attempts (to stdout / Heroku logs)
# Accepts: true/false or 1/0
AUTH_LOG=false
# Optional: configure admin login credentials used by /api/auth/login
# You can set a single pair:
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=supersecret
# Or allow multiple emails to share the same password (comma-separated):
# ADMIN_EMAILS=owner@example.com,admin@example.com
# ADMIN_PASS=supersecret
# Optional: force role label for admin users (defaults to 'admin')
# ADMIN_ROLE=admin
# Optional: in demos, allow any non-empty email/password to log in as admin (DO NOT enable in real production)
# ALLOW_DEMO_LOGIN=false

# Payments (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=

# Optional: language-specific PricingEmbed calculator URLs for the homepage
VITE_PRICING_EMBED_URL_DE=
VITE_PRICING_EMBED_URL_EN=

# Email (optional; if not set, JSON transport is used and emails print to logs)
EMAIL_TRANSPORT=json
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@example.com
STUDIO_NOTIFY_EMAIL=

# Voucher/Downloads
VOUCHER_LOGO_URL=
DOWNLOAD_TOKEN_SECRET=

# Coupons (optional)
COUPONS_JSON=
# Comma-separated list of coupon codes restricted to €95 voucher items
COUPONS_95_ONLY=VCWIEN,CL50,WL50,VW50

# Messaging providers (optional)
# Vonage
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_WHATSAPP_FROM=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SMS_FROM=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# AI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Pulse / AxixOS Social — auto-distribute blog Social Packs to social channels.
# When a blog post publishes, its Social Pack is pushed into Pulse (POST /api/v1/posts),
# which schedules + publishes to the connected accounts on its own cron.
PULSE_API_BASE=https://axixos-social.de
PULSE_API_KEY=                       # pls_live_... (mint in Pulse: scripts/mint-social-key.ts). Required to enable.
PULSE_AUTODISTRIBUTE=false           # master switch: true = auto-send on each blog publish
PULSE_MODE=draft                     # draft (review in Pulse) | schedule (at publish time) | now (publish immediately)
PULSE_TZ=Europe/Vienna               # timezone for schedule_time
PULSE_PLATFORMS=facebook,instagram,threads,linkedin,googlebusiness,pinterest
# Optional per-platform account selectors (only needed if multiple accounts per platform in Pulse):
# PULSE_PROFILE_FACEBOOK=
# PULSE_PROFILE_INSTAGRAM=
# PULSE_PROFILE_LINKEDIN=

# Price Research APIs (for Price Wizard competitor research)
TAVILY_API_KEY=
SERPER_API_KEY=
GEOAPIFY_API_KEY=

# Calendar import (optional for scripts)
ICS_URL=
BASE_URL=
