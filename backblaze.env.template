# Backblaze (S3-compatible) settings for local development
# Copy these lines into your local .env at the project root.
# Then restart the server (npm start or npm run dev:win).

# REQUIRED - paste from Heroku
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# From Heroku (public values)
AWS_S3_BUCKET=TogNinja
AWS_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
AWS_REGION=eu-central-003

# Helpful local defaults
NODE_ENV=development
DEMO_MODE=true

# Keep your other existing variables (DATABASE_URL, SESSION_SECRET, etc.)

